# Secret used to sign JWTs — generate a real random value in production,
# e.g. `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite file (relative to backend/) — swap for a Postgres URL in production
DATABASE_URL=sqlite:///./red_giant.db

# Default admin account created by `python seed.py`
ADMIN_EMAIL=admin@redgiant.co.ke
ADMIN_PASSWORD=change-me-please
